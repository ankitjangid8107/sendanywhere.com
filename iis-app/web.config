<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Internet access via port forwarding is OFF. To allow it set AllowInternet="true" AND an AccessKey of 8+ characters.
         LAN devices never need the key. Wrong keys/codes are rate-limited (20 tries / 15 min per IP). -->
    <add key="AllowInternet" value="false" />
    <add key="AccessKey" value="" />
  </appSettings>
  <system.web>
    <authentication mode="None" />
    <httpRuntime maxRequestLength="65536" executionTimeout="3600" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="67108864" />
      </requestFiltering>
    </security>
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <remove name="SendAnywhereAshx" />
      <add name="SendAnywhereAshx" path="*.ashx" verb="GET,HEAD,POST" type="System.Web.UI.SimpleHandlerFactory" preCondition="integratedMode" resourceType="Unspecified" />
    </handlers>
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>
  </system.webServer>
</configuration>
